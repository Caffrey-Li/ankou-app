{
  "identifier": "default",
  "description": "本地主窗口。只放行授权、设置、密钥、历史、用量与更新命令。窗口不能发起网络请求；检查与下载更新由应用后台进行。",
  "windows": [
    "main",
    "tray"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-list-grants",
    "allow-revoke",
    "allow-get-settings",
    "allow-set-settings",
    "allow-save-deepseek-key",
    "allow-delete-deepseek-key",
    "allow-deepseek-key-saved",
    "allow-clear-history",
    "allow-discover-tools",
    "allow-complete-setup",
    "allow-get-usage",
    "allow-refresh-usage",
    "allow-set-capability",
    "allow-list-conversations",
    "allow-prepare-handoff",
    "allow-begin-summary",
    "allow-send-summary",
    "allow-prepare-deeplink",
    "allow-place-deeplink",
    "allow-prepare-place",
    "allow-place-handoff",
    "allow-export-handoff",
    "allow-organize-handoff",
    "allow-tool-icons",
    "allow-scan-space",
    "allow-cancel-scan",
    "allow-prepare-cleanup",
    "allow-run-cleanup",
    "allow-scan-system",
    "allow-cancel-system-scan",
    "allow-prepare-system-cleanup",
    "allow-run-system-cleanup",
    "allow-open-privacy-settings",
    "allow-send-notice",
    "allow-tray-action",
    "allow-check-update",
    "allow-install-update"
  ]
}
